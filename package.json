{
  "name": "parkwright",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "node --experimental-transform-types --disable-warning=ExperimentalWarning apps/server/scripts/verify-park.ts",
    "check:gas": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/chain/src/check-gas.ts",
    "e2e": "pnpm --filter @parkwright/web build && pnpm --filter @parkwright/e2e e2e"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
